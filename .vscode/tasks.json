{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "git-status-check",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false
		},
		{
			"label": "git-branch-check",
			"type": "shell",
			"command": "git",
			"args": [
				"branch",
				"--show-current"
			],
			"isBackground": false
		},
		{
			"label": "git-remote-check",
			"type": "shell",
			"command": "git",
			"args": [
				"remote",
				"-v"
			],
			"isBackground": false
		},
		{
			"label": "git-publish-tasks-clean",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"git add .vscode/tasks.json && git commit -m \"chore: clean vscode tasks config\" && git push origin $(git branch --show-current)"
			],
			"isBackground": false
		}
	]
}